# Copy to .env and fill in. Never commit .env.

# --- The app (all local Ollama; user messages never leave the machine) ---
CHAT_MODEL=qwen3.5:4b          # generator
CLASSIFIER_MODEL=qwen3.5:4b    # crisis classifier, router, transliteration
USE_RAG=1                      # knowledge-base retrieval (needs `uv sync --extra rag`)
USE_TRANSLIT=1                 # Hinglish -> Devanagari before retrieval
USE_RERANKER=0                 # no gain at 14 cards (results/retrieval_eval.md)
OLLAMA_HOST=http://localhost:11434

# --- Offline data work only (public / synthetic text: translation, judge) ---
GEMINI_API_KEY=
GROQ_API_KEY=

# Set to 1 to skip loading IndicXlit (it needs a separate Python 3.10 env)
TAI_DISABLE_XLIT=0
