# Copy to .env and fill in. Never commit .env.

# LLM used for generation / crisis classifier / transliteration fallback
LLM_PROVIDER=ollama            # ollama | groq | hf
LLM_MODEL=llama3.1:8b
GROQ_API_KEY=

# Hugging Face (gated Llama weights, pushing the adapter)
HF_TOKEN=

# Set to 1 to skip loading IndicXlit (it needs a separate Python 3.10 env)
TAI_DISABLE_XLIT=0

# Optional experiment tracking; leave empty to disable
WANDB_API_KEY=
